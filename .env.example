# Explicit model and endpoint selection; no automatic model substitution.
SOC_VERIFIER_OPENROUTER_API_KEY=
SOC_VERIFIER_MODEL=
SOC_VERIFIER_PROVIDER=
SOC_VERIFIER_ARTIFACT_DIR=artifacts
SOC_VERIFIER_MAX_REVISIONS=2
SOC_VERIFIER_MAX_OUTPUT_TOKENS=12000
SOC_VERIFIER_MAX_INPUT_CHARACTERS=2000000
SOC_VERIFIER_REQUEST_TIMEOUT_SECONDS=120
SOC_VERIFIER_CHUNK_MAX_CHARACTERS=24000
SOC_VERIFIER_PLAN_BATCH_SIZE=8
SOC_VERIFIER_BATCH_WORKERS=1
SOC_VERIFIER_MAX_MODEL_CALLS=200
SOC_VERIFIER_MAX_COST_USD=2.00
# Local development uses a persistent SQLite checkpointer by default.
# Install the postgres extra and set this for PostgreSQL checkpoints.
# SOC_VERIFIER_CHECKPOINT_DSN=postgresql://user:password@localhost:5432/soc_verifier
